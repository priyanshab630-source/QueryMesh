# ---- LLM (optional) -------------------------------------------------------
# Without a key the writer falls back to extractive, citation-verified quotes.
# Get one at https://dashboard.sarvam.ai (any OpenAI-compatible endpoint works)
SARVAM_API_KEY=
LLM_BASE_URL=https://api.sarvam.ai/v1/chat/completions
LLM_MODEL=sarvam-m

# ---- Embeddings (optional) -----------------------------------------------
# Without a key, deterministic hashed vectors are used for dense retrieval.
JINA_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=256

# ---- Cache (optional) ----------------------------------------------------
# e.g. redis://default:<password>@<host>:<port>  (Upstash works as-is)
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ---- Orchestration engine -------------------------------------------------
USE_LANGGRAPH=0

# ---- Auth (JWT HS256) ----------------------------------------------------
AUTH_ENABLED=0
JWT_SECRET=dev-secret-change-me
JWT_TTL_SECONDS=3600
API_CLIENT_ID=demo-client
API_CLIENT_SECRET=demo-secret

# ---- A2A -----------------------------------------------------------------
A2A_PUBLIC_URL=http://localhost:8000

# ---- Observability -------------------------------------------------------
TRACE_ENABLED=1
TRACE_DIR=traces
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=querymesh
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Ingestion -----------------------------------------------------------
USE_DOCLING=0
TELEGRAM_BOT_TOKEN=

# ---- Retrieval -----------------------------------------------------------
TOP_K=6
CHUNK_WORDS=90
MAX_RETRIEVAL_LOOPS=2
RELEVANCE_THRESHOLD=0.35
MIN_COVERAGE=0.35
RRF_K=60
